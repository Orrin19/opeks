{
  "name": "opeks",
  "version": "3.1.1",
  "description": "TypeScript-based bot for Discord",
  "main": "dist/index.js",
  "engines": {
    "node": "24.11.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/test/**/*.test.js\"",
    "release": "commit-and-tag-version --noBumpWhenEmptyChanges",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "prepare": "husky"
  },
  "author": "Orrin19",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "gaussian": "^1.3.0",
    "nekos.life": "^3.0.0",
    "sagiri": "^4.3.0",
    "trace.moe.ts": "1.3.10"
  },
  "devDependencies": {
    "@types/gaussian": "^1.2.2",
    "@types/node": "^24.19.2",
    "@types/superagent": "^8.1.11",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}

# Discord bot token (required)
TOKEN=

# Embed accent color, HEX or decimal (default: 0xfefefe)
LINE_COLOR=0xfefefe

# Bot presence (default: Opeks / Playing)
ACTIVITY_NAME=Opeks
ACTIVITY_TYPE=0

# Hosting label shown in /about (default: local)
HOSTING=local

# OpenRouter (LLM) settings — required for /verdict and /wiki
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# SauceNAO token — required for /sauce
SAUCE_TOKEN=

# Logging verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info
